CREATE FUNCTION add(a int, b int)
RETURNS int
LANGUAGE sql
IMMUTABLE
STRICT
AS $$
SELECT a + b
$$;

CREATE PROCEDURE p()
BEGIN ATOMIC
    INSERT INTO t
    VALUES (1);
    SELECT 1;
END;

DO $$
BEGIN
    PERFORM 1;
END
$$;

CALL p();
